# Dockerfile.codeengine
# Thin layer on top of the repo's own build process.
# Build context: repo root (connectors-main/)
#
# IMPORTANT: IBM Code Engine runs on amd64 (x86_64). Always build with:
#   docker buildx build --platform linux/amd64 -f Dockerfile.codeengine ...
# Omitting --platform on Apple Silicon (arm64) produces an arm64 binary that
# Code Engine cannot execute ("exec format error").

FROM cgr.dev/chainguard/wolfi-base:latest
ARG python_version=3.11

USER root
RUN apk add --no-cache python3=~${python_version} make git

COPY --chown=nonroot:nonroot . /app

USER nonroot
WORKDIR /app
RUN make clean install-package freeze
RUN ln -s app/connectors_service/.venv/bin /app/bin

USER root
RUN apk del make git

USER nonroot
# No ENTRYPOINT — command and arguments are supplied by the Code Engine job definition
# via --command "/app/bin/elastic-ingest" --argument "-c" --argument "/elastic-connectors/config/config.yml"
